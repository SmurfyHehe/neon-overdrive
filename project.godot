; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Boost Simcade"
config/version="0.1.0"
config/icon="res://assets/brand/logo_B4_combined_256.png"
boot_splash/image="res://assets/brand/boot_splash.png"
boot_splash/bg_color=Color(0.0549, 0.0784, 0.1412, 1)
run/main_scene="res://Game.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

TickRate="*res://scripts/core/tick_rate.gd"

[display]

window/vsync/vsync_mode.editor=0

[gui]

theme/custom_font="res://assets/fonts/BarlowSemiCondensed-Regular.ttf"

