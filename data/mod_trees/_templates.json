{
	"version": 1,
	"_note": "Mod tree template library, step T1 (2026-10-10). A template is one kind of node, written RELATIVE to the car it lands on (mul and add on what the car has, mul_redline for rpm points), so the same template fits every car. A car's tree file (data/mod_trees/<car_id>.json) says which template each slot uses and may override single ops with its own absolute numbers. Read and applied by scripts/car/mod_tree.gd; checked by tests/car/mod_tree.gd.",

	"schema": {
		"_note": "What ModTree.validate_tree() enforces. A node is a template with the car's fields laid over it.",
		"op": "{\"path\": P, one of \"set\": v | \"add\": d | \"mul\": k | \"mul_redline\": k, optional \"override\": true}. P uses TuneParams' path syntax (max_torque, torque_shape/low_end, gear_ratios/4, coefficient_of_friction/Road) and may name any Vehicle or PlayerCar property, or a spec-only key (torque_shape, boost_kind). mul_redline writes k x the build's max_rpm at that moment. set may carry a string (boost_kind).",
		"node": "id, level (0 Service, 1 Fork, 2 L2, 3 capstone, \"side\"), parent (id, or a list of ids for a capstone), template, name, feel (the card line), cost_nights, band_min (T0-T5), ops, tuner_window {path: [lo, hi]}, sound, measure, optional replaces (a parent id whose ops this node drops), override (true: its sets may land on an earlier node's set), requires (side nodes: a core node id). The look parts a node gives for free are in docs/design/fleet/fleet.json (tree_parts), not here.",
		"rules": "A node must change a number or a sound. Two fitted nodes setting one path is a data error unless the later one says override or replaces. No node may turn a driven axle on or off. Every node must move its measure number past its threshold on the test track."
	},

	"measures": {
		"_note": "The tests a measure rule may name, each a TuneTrack metric of the build WITH the node against the same build WITHOUT it. 'better' is the direction the node must move it. Thresholds: better_by_pct (percent of the without-node number), better_by_s, better_by_m, better_by_deg.",
		"launch_0_100": {"metric": "t_0_100", "better": "less", "label": "0-100 km/h, s"},
		"quarter_400": {"metric": "t_400", "better": "less", "label": "Standing 400 m, s"},
		"pull_100_200": {"metric": "t_100_200", "better": "less", "label": "100-200 km/h, s"},
		"top_speed": {"metric": "top_speed_kmh", "better": "more", "label": "Top speed, km/h"},
		"brake_100_0": {"metric": "brake_dist_100", "better": "less", "label": "100-0 km/h, m"},
		"corner_g": {"metric": "peak_lat_g", "better": "more", "label": "Peak cornering, g"},
		"slide_angle": {"metric": "max_slip_deg", "better": "more", "label": "Slide angle held, deg"},
		"turn_radius": {"metric": "turn_radius_m", "better": "less", "label": "Tightest turn at low speed, m"}
	},

	"sounds": {
		"_note": "Sound hooks a node's 'sound' block may name. 'turbo' entries are TurboVoice presets (the fitted build's spec gets turbo_voice from them); the rest are names for EngineAudio to pick up when its side lands (not read yet).",
		"turbo": {
			"small_whistle": {"part": "small", "valve": "recirc", "valve_level": 0.6},
			"twin_whistle": {"part": "small", "valve": "atmo", "valve_level": 0.8},
			"medium_whistle": {"part": "medium", "valve": "atmo", "valve_level": 0.9},
			"big_whistle": {"part": "big", "valve": "atmo", "valve_level": 1.0}
		},
		"blower": ["whine"],
		"intake": ["open", "trumpets"],
		"engine": ["high_rev", "lumpy", "swap"]
	},

	"templates": {
		"service": {"icon": "wrench", "minigame": "plug_gap",
			"ops": [{"path": "max_torque", "mul": 1.04}],
			"measure": {"test": "quarter_400", "better_by_pct": 0.5}},

		"na_breathe": {"icon": "cam", "minigame": "cam_timing",
			"ops": [{"path": "max_torque", "mul": 1.06}, {"path": "max_rpm", "add": 500}, {"path": "torque_shape/falloff", "add": 0.05}, {"path": "throttle_speed", "mul": 1.15}],
			"sound": {"intake": "open"},
			"measure": {"test": "pull_100_200", "better_by_pct": 3}},
		"na_screamer": {"icon": "tach_high", "minigame": "valve_shim",
			"ops": [{"path": "max_torque", "mul": 0.96}, {"path": "max_rpm", "mul": 1.2}, {"path": "torque_shape/low_end", "add": -0.1}, {"path": "torque_shape/peak_pos", "add": 0.15}, {"path": "torque_shape/falloff", "add": 0.1}, {"path": "motor_moment", "mul": 0.85}, {"path": "vehicle_mass", "add": -10}],
			"sound": {"engine": "high_rev"},
			"measure": {"test": "top_speed", "better_by_pct": 3}},
		"na_stroker": {"icon": "crank", "minigame": "torque_wrench",
			"ops": [{"path": "max_torque", "mul": 1.22}, {"path": "max_rpm", "add": -500}, {"path": "torque_shape/low_end", "add": 0.15}, {"path": "torque_shape/peak_pos", "add": -0.1}, {"path": "torque_shape/falloff", "add": -0.1}, {"path": "vehicle_mass", "add": 15}],
			"sound": {"engine": "lumpy"},
			"measure": {"test": "quarter_400", "better_by_pct": 1}},
		"na_race_cam": {"icon": "cam_lumpy", "minigame": "cam_timing",
			"ops": [{"path": "max_torque", "mul": 1.08}, {"path": "max_rpm", "add": 600}, {"path": "torque_shape/low_end", "add": -0.1}, {"path": "torque_shape/peak_pos", "add": 0.1}, {"path": "idle_rpm", "add": 150}],
			"sound": {"engine": "lumpy"},
			"measure": {"test": "pull_100_200", "better_by_pct": 4}},

		"turbo_small": {"icon": "turbo_small", "minigame": "hose_clamp",
			"ops": [{"path": "boost_kind", "set": "single"}, {"path": "turbo_boost_max", "set": 0.5}, {"path": "turbo_gain", "set": 0.18}, {"path": "turbo_rpm_thresh", "mul_redline": 0.40}, {"path": "turbo_tau_up", "set": 0.5}, {"path": "torque_shape/low_end", "add": -0.05}, {"path": "vehicle_mass", "add": 20}],
			"tuner_window": {"turbo_boost_max": [0.3, 0.5]},
			"sound": {"turbo": "small_whistle", "blow_off": true},
			"measure": {"test": "pull_100_200", "better_by_pct": 5}},
		"turbo_big_single": {"icon": "turbo_big", "minigame": "hose_clamp", "override": true,
			"ops": [{"path": "boost_kind", "set": "single"}, {"path": "turbo_boost_max", "set": 1.0}, {"path": "turbo_gain", "set": 0.40}, {"path": "turbo_rpm_thresh", "mul_redline": 0.55}, {"path": "turbo_tau_up", "set": 1.1}, {"path": "torque_shape/low_end", "add": -0.08}, {"path": "torque_shape/peak_pos", "add": 0.2}, {"path": "torque_shape/falloff", "add": 0.3}, {"path": "vehicle_mass", "add": 15}],
			"tuner_window": {"turbo_boost_max": [0.6, 1.0]},
			"sound": {"turbo": "big_whistle", "blow_off": true},
			"measure": {"test": "pull_100_200", "better_by_pct": 8}},
		"turbo_twin": {"icon": "turbo_twin", "minigame": "hose_clamp", "override": true,
			"ops": [{"path": "boost_kind", "set": "twin"}, {"path": "turbo_boost_max", "set": 0.8}, {"path": "turbo_gain", "set": 0.36}, {"path": "turbo_rpm_thresh", "mul_redline": 0.45}, {"path": "turbo_tau_up", "set": 0.7}, {"path": "torque_shape/plateau", "add": 0.1}, {"path": "torque_shape/falloff", "add": 0.05}, {"path": "vehicle_mass", "add": 10}],
			"tuner_window": {"turbo_boost_max": [0.5, 0.8]},
			"sound": {"turbo": "twin_whistle", "blow_off": true},
			"measure": {"test": "quarter_400", "better_by_pct": 2}},
		"turbo_sequential": {"icon": "turbo_seq", "minigame": "hose_clamp", "override": true,
			"ops": [{"path": "boost_kind", "set": "sequential"}, {"path": "turbo_boost_max", "set": 0.9}, {"path": "turbo_gain", "set": 0.38}, {"path": "turbo_rpm_thresh", "mul_redline": 0.45}, {"path": "turbo_tau_up", "set": 0.9}, {"path": "vehicle_mass", "add": 20}],
			"tuner_window": {"turbo_boost_max": [0.5, 0.9]},
			"sound": {"turbo": "medium_whistle", "blow_off": true},
			"measure": {"test": "pull_100_200", "better_by_pct": 6}},
		"blower_roots": {"icon": "blower", "minigame": "belt_tension",
			"ops": [{"path": "boost_kind", "set": "roots"}, {"path": "turbo_boost_max", "set": 0.5}, {"path": "turbo_gain", "set": 0.28}, {"path": "torque_shape/low_end", "add": 0.1}, {"path": "vehicle_mass", "add": 30}],
			"tuner_window": {"turbo_boost_max": [0.3, 0.5]},
			"sound": {"blower": "whine", "blow_off": false},
			"measure": {"test": "quarter_400", "better_by_pct": 3}},
		"twincharger": {"icon": "twincharger", "minigame": "belt_tension", "override": true,
			"ops": [{"path": "boost_kind", "set": "twincharger"}, {"path": "turbo_boost_max", "set": 0.9}, {"path": "turbo_gain", "set": 0.38}, {"path": "turbo_rpm_thresh", "mul_redline": 0.50}, {"path": "turbo_tau_up", "set": 0.9}, {"path": "vehicle_mass", "add": 25}],
			"tuner_window": {"turbo_boost_max": [0.5, 0.9]},
			"sound": {"turbo": "medium_whistle", "blower": "whine", "blow_off": true},
			"measure": {"test": "pull_100_200", "better_by_pct": 6}},

		"swap_bigger": {"icon": "engine_swap", "minigame": "engine_hoist",
			"ops": [{"path": "max_torque", "mul": 1.35}, {"path": "max_rpm", "mul": 0.9}, {"path": "torque_shape/low_end", "add": 0.1}, {"path": "vehicle_mass", "add": 45}, {"path": "front_weight_distribution", "add": 0.02}],
			"sound": {"engine": "swap"},
			"measure": {"test": "quarter_400", "better_by_pct": 3}},
		"swap_light_peaky": {"icon": "engine_swap", "minigame": "engine_hoist",
			"ops": [{"path": "max_torque", "mul": 0.92}, {"path": "max_rpm", "mul": 1.35}, {"path": "torque_shape/peak_pos", "add": 0.15}, {"path": "motor_moment", "mul": 0.6}, {"path": "vehicle_mass", "add": -40}],
			"sound": {"engine": "high_rev"},
			"measure": {"test": "top_speed", "better_by_pct": 3}},
		"flywheel_light": {"icon": "flywheel", "minigame": "torque_wrench",
			"ops": [{"path": "motor_moment", "mul": 0.75}, {"path": "throttle_speed", "mul": 1.2}, {"path": "vehicle_mass", "add": -6}],
			"measure": {"test": "launch_0_100", "better_by_pct": 1}},
		"seam_weld_strip": {"icon": "welder", "minigame": "spot_weld",
			"ops": [{"path": "vehicle_mass", "mul": 0.94}, {"path": "center_of_gravity_height_offset", "add": -0.02}],
			"measure": {"test": "brake_100_0", "better_by_pct": 1}},
		"awd_rear_bias": {"icon": "diff", "minigame": "torque_wrench",
			"_note": "AWD cars only: moves the split, never to 0 or 1 (no node turns a driven axle on or off).",
			"ops": [{"path": "front_torque_split", "add": -0.15}],
			"measure": {"test": "slide_angle", "better_by_deg": 1}},

		"capstone_grip": {"icon": "wing", "minigame": "alignment",
			"ops": [{"path": "aero_downforce_coefficient_front", "add": 0.15}, {"path": "aero_downforce_coefficient_rear", "add": 0.25}, {"path": "coefficient_of_drag", "mul": 1.04}, {"path": "center_of_gravity_height_offset", "add": -0.04}, {"path": "tyre_load_sensitivity", "mul": 0.85}],
			"measure": {"test": "corner_g", "better_by_pct": 1}},
		"capstone_slide": {"icon": "handbrake", "minigame": "alignment",
			"ops": [{"path": "rear_locking_differential_engage_torque", "set": 80}, {"path": "max_steering_angle", "set": 0.872665}, {"path": "steering_speed", "mul": 1.15}, {"path": "front_weight_distribution", "add": -0.02}],
			"measure": {"test": "turn_radius", "better_by_pct": 10}},

		"side_ride_drop": {"icon": "spring", "minigame": "spring_seat",
			"ops": [{"path": "front_spring_length", "add": -0.02}],
			"measure": {"test": "corner_g", "better_by_pct": 0.2}},
		"side_drag_trim": {"icon": "lamp", "minigame": "panel_fit",
			"ops": [{"path": "coefficient_of_drag", "mul": 0.97}, {"path": "vehicle_mass", "add": -6}],
			"measure": {"test": "pull_100_200", "better_by_pct": 0.2}},
		"side_mass_trim": {"icon": "scale", "minigame": "panel_fit",
			"ops": [{"path": "vehicle_mass", "add": -12}],
			"measure": {"test": "quarter_400", "better_by_pct": 0.1}},
		"side_voice": {"icon": "horn", "minigame": "none",
			"_note": "Sound only: no ops, so no measure. The car's node names the sound.",
			"ops": []}
	}
}
